# Copy to .env (or export in your shell). Every setting is optional.

# --- LLM ---------------------------------------------------------------
# auto: use Claude when ANTHROPIC_API_KEY is set, otherwise the offline evidence engine
# claude: always use Claude; offline: never call an LLM
NEWSREN_LLM=auto
ANTHROPIC_API_KEY=
NEWSREN_MODEL=claude-opus-5-5
NEWSREN_EFFORT=medium

# Orchestrator budgets (per agent task)
NEWSREN_AGENT_MAX_TOOL_CALLS=8
NEWSREN_AGENT_TIMEOUT_SECONDS=120
NEWSREN_AGENT_MAX_COST_USD=0.75
NEWSREN_AGENT_MAX_OUTPUT_TOKENS=16000

# --- Storage -----------------------------------------------------------
NEWSREN_DATA_DIR=data
# NEWSREN_DATABASE_URL=sqlite:///data/newsren.db

# --- Editorial controls ------------------------------------------------
# Human approval before publication (finance is always reviewed regardless)
NEWSREN_REQUIRE_HUMAN_APPROVAL=true
# Low-risk personal briefings may be delivered automatically
NEWSREN_AUTO_DELIVER_BRIEFINGS=true

# --- Source access -----------------------------------------------------
# SEC EDGAR requires a descriptive User-Agent with a contact address
NEWSREN_CONTACT_EMAIL=newsroom@example.org
NEWSREN_FETCH_TIMEOUT_SECONDS=20
NEWSREN_MAX_ITEMS_PER_SOURCE=30

# --- Email briefings (without SMTP, emails are written to data/outbox) --
NEWSREN_SMTP_HOST=
NEWSREN_SMTP_PORT=587
NEWSREN_SMTP_USER=
NEWSREN_SMTP_PASSWORD=
NEWSREN_SMTP_FROM=The Newsren <briefings@example.org>
NEWSREN_SMTP_STARTTLS=true

# --- Web ---------------------------------------------------------------
# Set a long random value in production (sessions are signed with it)
NEWSREN_SECRET_KEY=
NEWSREN_BASE_URL=http://localhost:8000
# Run the pipeline in-process every N minutes (or use cron: `newsren pipeline`)
NEWSREN_SCHEDULER=false
NEWSREN_SCHEDULER_INTERVAL_MINUTES=60
